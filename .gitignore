**/vendor/
**/dist/
**/build/

# ── IDE / Editores ──────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Sistema operacional ─────────────────────
desktop.ini
ehthumbs.db
ehthumbs_vista.db
._*

